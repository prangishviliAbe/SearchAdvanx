{
    "name": "abeprangishvili/searchadvanx",
    "description": "Advanced WordPress search engine plugin with Elementor and JetEngine support, including REST API functionality for cross-site searching.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Abe Prangishvili",
            "email": "abe@abeprangishvili.com",
            "homepage": "https://abeprangishvili.com"
        }
    ],
    "keywords": [
        "wordpress",
        "search",
        "api",
        "elementor", 
        "jetengine",
        "rest-api",
        "multi-site"
    ],
    "homepage": "https://github.com/abeprangishvili/SearchAdvanx",
    "support": {
        "issues": "https://github.com/abeprangishvili/SearchAdvanx/issues",
        "source": "https://github.com/abeprangishvili/SearchAdvanx"
    },
    "require": {
        "php": ">=7.4",
        "wordpress": ">=5.0"
    },
    "autoload": {
        "psr-4": {
            "SearchAdvanx\\": "includes/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "test": "echo 'No tests configured yet.'"
    }
}